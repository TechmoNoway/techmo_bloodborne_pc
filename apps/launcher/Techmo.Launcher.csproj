<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Techmo.Launcher</AssemblyName>
    <Product>Techmo Bloodborne</Product>
    <Title>Techmo Bloodborne Launcher</Title>
    <Description>Techmo Bloodborne Windows launcher.</Description>
    <RootNamespace>BloodborneLauncher</RootNamespace>
    <ApplicationIcon>Assets/bloodborne.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <TechmoPublicRelease Condition="'$(TechmoPublicRelease)' == ''">true</TechmoPublicRelease>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TechmoPublicRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);TECHMO_PUBLIC_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/*.png" />
    <Resource Include="Assets/bloodborne.ico" />
    <EmbeddedResource Include="Localization/*.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../engine-backend/Techmo.Launcher.csproj" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
</Project>
