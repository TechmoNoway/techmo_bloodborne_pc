            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#41382F" BorderThickness="0,0,0,1" Background="#181512">
