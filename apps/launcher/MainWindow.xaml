                            <TextBlock Text="{local:Loc Key=Ui.Advanced}" FontFamily="Georgia" FontSize="32" />
                            <TextBlock Text="{local:Loc Key=Ui.Developer_and_diagnostics_options}" Foreground="#B0A89C" Margin="0,4,0,24" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="DeveloperModeCheck" Content="{local:Loc Key=Ui.Developer_Mode}" />
                                    <CheckBox x:Name="DetailedLogsCheck" Content="{local:Loc Key=Ui.Detailed_logs}" />
                                    <CheckBox x:Name="FrameStatsCheck" Content="{local:Loc Key=Ui.Frame_statistics}" />
                                    <CheckBox x:Name="GpuProfileCheck" Content="{local:Loc Key=Diagnostics.Gpu_profiling}" />
                                    <CheckBox x:Name="AudioStatsCheck" Content="{local:Loc Key=Ui.Audio_statistics}" />
                                    <CheckBox x:Name="FsrProfileCheck" Content="{local:Loc Key=Ui.FSR_4_profiling}" />
                                    <TextBlock TextWrapping="Wrap" Text="{local:Loc Key=Ui.Every_game_session_is_saved_automatically_to_the_logs_folder_These_switches_add_extra_diagnostic_output_a}" Foreground="#B57B7D" Margin="0,10,0,0" />
                                    <Button Content="{local:Loc Key=Ui.Open_Logs_Folder}" Width="180" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="14,8" Click="OpenLogs_Click" ToolTip="{local:Loc Key=Ui.Open_the_folder_containing_bbport_session_logs}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Border Grid.Row="2" BorderBrush="#41382F" BorderThickness="0,1,0,0" Background="#181512">
                <Grid Margin="20,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock Text="●" Foreground="#B58561" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="WINDOWS · x64" FontSize="10" Foreground="#AC9C87" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterGpu" Text="{local:Loc Key=Ui.GPU_detecting}" Foreground="#9F978B" FontSize="11" MaxWidth="330" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterFps" Text="   |   60 FPS" Foreground="#9F978B" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterMessage" Text="" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#C5AD8D" FontSize="11" Margin="14,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="{local:Loc Key=Ui.Save_settings}" Click="Save_Click" Padding="18,7" ToolTip="{local:Loc Key=Ui.Save_all_launcher_settings}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="CaptureOverlay" Grid.RowSpan="3" Panel.ZIndex="10" Visibility="Collapsed" Background="#E5181512" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Border Style="{StaticResource CardStyle}" MaxWidth="520" Margin="24" Padding="28" VerticalAlignment="Center" BorderBrush="#8C7560">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=Controls.Capture_title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="CaptureAction" FontFamily="Georgia" FontSize="26" TextWrapping="Wrap" />
                        <TextBlock x:Name="CapturePrompt" FontSize="16" TextWrapping="Wrap" Margin="0,22,0,0" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{local:Loc Key=Controls.Capture_hint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,20" />
                        <WrapPanel>
                            <Button x:Name="CaptureEscapeButton" Content="{local:Loc Key=Controls.Assign_escape}" Tag="capture-command" Click="EscapeCapture_Click" Margin="0,0,8,8" />
                            <Button Content="{local:Loc Key=Controls.Clear_slot}" Tag="capture-command" Click="ClearCapture_Click" Margin="0,0,8,8" />
                            <Button Content="{local:Loc Key=Controls.Cancel}" Tag="capture-command" Click="CancelCapture_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
