                        <Button x:Name="MaximizeButton" Content="" Style="{StaticResource CaptionButton}" AutomationProperties.Name="{local:Loc Key=Ui.Maximize_or_restore}" ToolTip="{local:Loc Key=Ui.Maximize_or_restore}" Click="Maximize_Click" />
                        <Button Content="" Style="{StaticResource CaptionButton}" BorderBrush="#763A30" AutomationProperties.Name="{local:Loc Key=Ui.Close}" ToolTip="{local:Loc Key=Ui.Close}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="188" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#181512" BorderBrush="#41382F" BorderThickness="0,0,1,0">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="SidebarNavigation" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Text="{local:Loc Key=Ui.Workspace}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="24,0,0,12" />
                                <Button x:Name="NavHome" Style="{StaticResource NavButton}" CommandParameter="Home" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Play}" Tag="active">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Play}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavGeneral" Style="{StaticResource NavButton}" CommandParameter="General" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.General}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.General}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavGraphics" Style="{StaticResource NavButton}" CommandParameter="Graphics" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Graphics}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Graphics}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavPerformance" Style="{StaticResource NavButton}" CommandParameter="Performance" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Performance}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Performance}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavController" Style="{StaticResource NavButton}" CommandParameter="Controller" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Controls}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Controls}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavOnline" Style="{StaticResource NavButton}" CommandParameter="Online" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Online}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Online}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavMods" Style="{StaticResource NavButton}" CommandParameter="Mods" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Mods}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Mods}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavAdvanced" Style="{StaticResource NavButton}" CommandParameter="Advanced" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Advanced}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Advanced}" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid x:Name="SidebarArt" Grid.Row="1" Height="100" Margin="20,16,20,22">
                            <Rectangle Width="130" Height="56" VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{local:Loc Key=Ui.Bloodborne_logo}">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="Assets/bloodborne-logo.png" Viewbox="0,0.06,1,0.76" Stretch="Uniform" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="WorkspaceHeader" Margin="28,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="The Hunter’s Desk" FontFamily="Georgia" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageLabel" Text="{local:Loc Key=Ui.Launcher_language}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="UiLanguageCombo" AutomationProperties.Name="{local:Loc Key=Ui.Launcher_language}" Width="136" HorizontalAlignment="Left" SelectionChanged="UiLanguage_Changed">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                                    </ComboBox>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HomeLayout" Margin="28,8,28,28" MaxWidth="1400">
                            <TextBlock Text="{local:Loc Key=Ui.Next_hunt}" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
                            <Grid x:Name="HuntGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition x:Name="PosterColumn" Width="*" /><ColumnDefinition x:Name="LaunchColumn" Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="GamePoster" Background="#24201C" BorderBrush="#41382F" BorderThickness="1" CornerRadius="4" Margin="0,0,24,0" ClipToBounds="True" MinHeight="480">
                                    <Grid>
                                        <Image x:Name="HeroImage" Source="Assets/hunter-background.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                                        <Rectangle IsHitTestVisible="False">
                                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B0151311" Offset="0" /><GradientStop Color="#10151311" Offset=".4" /><GradientStop Color="#F5151311" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                                        </Rectangle>
                                        <StackPanel Margin="26,28" VerticalAlignment="Top"><TextBlock Text="BLOODBORNE" FontFamily="Georgia" FontSize="32" /><TextBlock Text="{local:Loc Key=Ui.Yharnam_awaits}" Foreground="#DDD0BC" Margin="0,10,0,0" /></StackPanel>
                                        <StackPanel Margin="26,24" VerticalAlignment="Bottom">
                                            <TextBlock Text="{local:Loc Key=Ui.Hunter_caption}" FontFamily="Georgia" FontSize="22" TextWrapping="Wrap" Margin="0,0,0,18" />
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{local:Loc Key=Ui.Game_version}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" /><TextBlock x:Name="GameVersionStatus" Style="{StaticResource StatusValue}" /></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="LaunchPanel" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="26" BorderBrush="#41382F" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{local:Loc Key=Ui.Prepare_hunt}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                        <TextBlock Text="{local:Loc Key=Ui.Your_game_setup}" FontFamily="Georgia" FontSize="28" TextWrapping="Wrap" />
                                        <TextBlock Text="{local:Loc Key=Ui.Launch_intro}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,20" />
                                        <Border BorderBrush="#41382F" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock Text="{local:Loc Key=Ui.Bloodborne_folder}" Foreground="{StaticResource MutedBrush}" Margin="0,6,16,6" />
                                                <TextBlock x:Name="GamePathStatus" Grid.Column="1" Style="{StaticResource StatusValue}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Row="1" Text="{local:Loc Key=Ui.Runtime}" Foreground="{StaticResource MutedBrush}" Margin="0,6,16,6" />
                                                <TextBlock x:Name="RuntimeStatus" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusValue}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Row="2" Text="{local:Loc Key=Ui.Input_device}" Foreground="{StaticResource MutedBrush}" Margin="0,6,16,6" />
                                                <TextBlock x:Name="InputStatus" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{local:Loc Key=Ui.Controller}" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=PcControlsCheck}" Value="True"><Setter Property="Text" Value="{local:Loc Key=Ui.Keyboard_plus_mouse}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="BrowseGameButton" Content="{local:Loc Key=Ui.Select_Bloodborne_folder}" Click="BrowseGame_Click" HorizontalContentAlignment="Center" Background="#452822" BorderBrush="#754137" />
                                        <Button x:Name="ConfigureGraphicsButton" Content="{local:Loc Key=Ui.Configure_graphics}" Click="ConfigureGraphics_Click" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
                                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="0,18,0,0" Click="Play_Click" Content="{local:Loc Key=Ui.PLAY_BLOODBORNE}" AutomationProperties.Name="{local:Loc Key=Ui.Play_Bloodborne}" />
                                        <TextBlock x:Name="PlayHint" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="LastSessionCard" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="{local:Loc Key=Diagnostics.Last_session}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="LastSessionStatus" FontSize="18" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="LastSessionDetail" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="LastSessionPerformance" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="{local:Loc Key=Diagnostics.Scope_hint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    <Button Content="{local:Loc Key=Diagnostics.Open_report}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenLastSession_Click" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0" Padding="18,16,8,8">
                                <StackPanel><TextBlock Text="{local:Loc Key=Ui.Q_U_I_C_K_S_E_T_T_I_N_G_S}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" /><UniformGrid x:Name="QuickSettingsGrid" Columns="5">
                                        <Border Style="{StaticResource QuickCard}">
                                            <StackPanel>
                                                <TextBlock Text="{local:Loc Key=Ui.Resolution}" FontFamily="Segoe UI" FontSize="13" Foreground="#C8BDAC" />
                                                <ComboBox x:Name="QuickResolution" Margin="0,8,0,0" AutomationProperties.Name="{local:Loc Key=Ui.Resolution}" SelectionChanged="QuickResolution_Changed">
                                                    <ComboBoxItem Content="1280x720" />
                                                    <ComboBoxItem Content="1920x1080" />
                                                    <ComboBoxItem Content="2560x1440" />
                                                    <ComboBoxItem Content="3840x2160" />
                                            <ComboBoxItem Content="2560x1080" />
                                            <ComboBoxItem Content="3440x1440" />
                                            <ComboBoxItem Content="3840x1600" />
                                            <ComboBoxItem Content="3840x1080" />
                                            <ComboBoxItem Content="5120x1440" />
                                            <ComboBoxItem Content="5120x2160" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
