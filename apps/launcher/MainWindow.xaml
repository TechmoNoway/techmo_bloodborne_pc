                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Borderless_Fullscreen}" />
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Windowed}" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuickCard}">
