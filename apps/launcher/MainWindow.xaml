                                                    <ComboBoxItem Content="DLSS" />
                                                    <ComboBoxItem Content="FSR 4.1.1" />
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.FSR_4_v07_legacy}" />
                                                    <ComboBoxItem Content="FSR 3.1" />
                                                    <ComboBoxItem Content="TAA" />
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Off}" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuickCard}">
                                            <StackPanel>
                                                <TextBlock Text="{local:Loc Key=Ui.Quality}" FontFamily="Segoe UI" FontSize="13" Foreground="#C8BDAC" />
                                                <ComboBox x:Name="QuickPreset" Margin="0,8,0,0" AutomationProperties.Name="{local:Loc Key=Ui.Quality}" SelectionChanged="QuickPreset_Changed">
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Native_AA}" />
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Quality}" />
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Balanced}" />
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Performance}" />
                                                    <ComboBoxItem Content="{local:Loc Key=Ui.Ultra_Performance}" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource QuickCard}">
                                            <StackPanel>
                                                <TextBlock Text="{local:Loc Key=Ui.Target_FPS}" FontFamily="Segoe UI" FontSize="13" Foreground="#C8BDAC" />
                                                <ComboBox x:Name="QuickFps" Margin="0,8,0,0" AutomationProperties.Name="{local:Loc Key=Ui.Target_FPS}" SelectionChanged="QuickFps_Changed">
                                                    <ComboBoxItem Content="30" />
                                                    <ComboBoxItem Content="60" />
                                                    <ComboBoxItem Content="90" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid></StackPanel>
                            </Border>
                            <Expander x:Name="SystemDetails" Header="{local:Loc Key=Ui.System_details}" Margin="0,20,0,0" Foreground="{StaticResource MutedBrush}">
