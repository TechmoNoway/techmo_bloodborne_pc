                                        <TextBlock Grid.Row="2" Text="DLSS" Style="{StaticResource StatusLabel}" /><TextBlock x:Name="DlssStatus" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusValue}" />
                                        <TextBlock Grid.Row="3" Text="FSR 3.1" Style="{StaticResource StatusLabel}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{local:Loc Key=Ui.Available}" Style="{StaticResource StatusValue}" Foreground="#A5CD99" />
                                        <TextBlock Grid.Row="4" Text="FSR 4" Style="{StaticResource StatusLabel}" /><TextBlock x:Name="Fsr4Status" Grid.Row="4" Grid.Column="1" Style="{StaticResource StatusValue}" />
                                    </Grid>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" x:Name="SettingsScrim" Background="#151311" Visibility="Collapsed" IsHitTestVisible="False" />
