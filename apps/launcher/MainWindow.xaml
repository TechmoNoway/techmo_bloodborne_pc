                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="GPU" Style="{StaticResource StatusLabel}" Margin="0,0,24,0" />
                                        <TextBlock x:Name="GpuStatus" Grid.Column="1" Style="{StaticResource StatusValue}" />
                                        <TextBlock Grid.Row="1" Text="{local:Loc Key=Ui.Renderer}" Style="{StaticResource StatusLabel}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Vulkan" Style="{StaticResource StatusValue}" />
                                        <TextBlock Grid.Row="2" Text="DLSS" Style="{StaticResource StatusLabel}" />
                                        <TextBlock x:Name="DlssStatus" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusValue}" />
                                        <TextBlock Grid.Row="3" Text="FSR 3.1" Style="{StaticResource StatusLabel}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{local:Loc Key=Ui.Available}" Style="{StaticResource StatusValue}" Foreground="#A5CD99" />
                                        <TextBlock Grid.Row="4" Text="FSR 4" Style="{StaticResource StatusLabel}" />
                                        <TextBlock x:Name="Fsr4Status" Grid.Row="4" Grid.Column="1" Style="{StaticResource StatusValue}" />
                                    </Grid>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="GeneralPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="26,6,26,26">
                            <TextBlock Text="{local:Loc Key=Hub.Settings}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{local:Loc Key=Hub.Settings_description}" Style="{StaticResource PageDescription}" />
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="LanguageLabel" Text="{local:Loc Key=Ui.Launcher_language}" />
                                    <ComboBox x:Name="UiLanguageCombo" AutomationProperties.Name="{local:Loc Key=Ui.Launcher_language}" Width="240" HorizontalAlignment="Left" SelectionChanged="UiLanguage_Changed" Margin="0,6,0,16">
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                                    </ComboBox>
                                    <TextBlock Text="{local:Loc Key=Hub.Appearance}" />
                                    <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left" Margin="0,6,0,16" SelectionChanged="Appearance_Changed" AutomationProperties.Name="{local:Loc Key=Hub.Appearance}">
                                        <ComboBoxItem Tag="dark" Content="{local:Loc Key=Hub.Dark}" />
                                        <ComboBoxItem Tag="light" Content="{local:Loc Key=Hub.Light}" />
                                        <ComboBoxItem Tag="system" Content="{local:Loc Key=Hub.System}" />
                                    </ComboBox>
                                    <CheckBox x:Name="ReducedMotionCheck" Content="{local:Loc Key=Hub.Reduce_motion}" Checked="AppearanceToggle_Changed" Unchecked="AppearanceToggle_Changed" />
                                    <TextBlock Text="{local:Loc Key=Hub.Profile_scope}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
                                <TextBlock Text="{local:Loc Key=Credits.Engine}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc Key=Ui.GAME_INSTALLATION}" />
                                    <TextBlock Text="{local:Loc Key=Ui.Bloodborne_folder}" />
                                    <DockPanel Margin="0,7,0,14">
                                        <Button DockPanel.Dock="Right" Content="{local:Loc Key=Ui.Browse}" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="BrowseGame_Click" />
                                        <TextBox x:Name="PathBox" AutomationProperties.Name="{local:Loc Key=Ui.Bloodborne_folder}" IsReadOnly="True" />
                                    </DockPanel>
                                    <TextBlock TextWrapping="Wrap" x:Name="PathValidationText" Foreground="{DynamicResource MutedBrush}" Text="{local:Loc Key=Ui.Choose_the_folder_containing_eboot_bin_and_sce_sys}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{local:Loc Key=Ui.PC_ENHANCEMENTS}" />
                                    <CheckBox x:Name="ChangeAppearanceCheck" Content="{local:Loc Key=Ui.Hunter_s_Dream_mirror_edit_appearance}" />
                                    <CheckBox x:Name="RebirthCheck" Content="{local:Loc Key=Ui.Altar_of_Despair_reset_attributes}" Margin="0,10,0,0" />
                                    <TextBlock Text="{local:Loc Key=Ui.Mirror_edit_appearance_in_the_Dream_workshop_Altar_requires_the_Yharnam_Stone_refunds_Blood_Echoes_and_of}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Grid x:Name="ApplyBarViewport" Grid.Row="2" Height="0" ClipToBounds="True" Visibility="Collapsed">
            <Border x:Name="ApplyBar" Height="68" VerticalAlignment="Top" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Border.RenderTransform><TranslateTransform x:Name="ApplyBarTranslate" Y="68" /></Border.RenderTransform>
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FooterMessage" Text="{local:Loc Key=Hub.Up_to_date}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="experiment-v2 · Engine 0.9.37 · Windows x64" FontSize="11" Foreground="{DynamicResource DimBrush}" />
                            <TextBlock x:Name="FooterGpu" Foreground="{DynamicResource DimBrush}" FontSize="11" MaxWidth="340" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FooterFps" Foreground="{DynamicResource DimBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="UndoSettingsButton" Content="{local:Loc Key=Hub.Undo}" Click="UndoSettings_Click" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0" Padding="16,11" ToolTip="{local:Loc Key=Hub.Undo_hint}" />
                        <Button x:Name="ApplySettingsButton" Content="{local:Loc Key=Hub.Apply_changes}" Style="{StaticResource PrimaryButton}" Click="Save_Click" VerticalAlignment="Center" ToolTip="{local:Loc Key=Hub.Apply_hint}" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
            <Grid x:Name="CaptureOverlay" Grid.RowSpan="3" Panel.ZIndex="10" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Border Style="{StaticResource CardStyle}" MaxWidth="520" Margin="24" Padding="28" VerticalAlignment="Center" BorderBrush="{DynamicResource AccentTextBrush}">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Key=Controls.Capture_title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="CaptureAction" FontFamily="Segoe UI" FontSize="26" TextWrapping="Wrap" />
                        <TextBlock x:Name="CapturePrompt" FontSize="16" TextWrapping="Wrap" Margin="0,22,0,0" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{local:Loc Key=Controls.Capture_hint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,20" />
                        <WrapPanel>
                            <Button x:Name="CaptureEscapeButton" Content="{local:Loc Key=Controls.Assign_escape}" Tag="capture-command" Click="EscapeCapture_Click" Margin="0,0,8,8" />
                            <Button Content="{local:Loc Key=Controls.Clear_slot}" Tag="capture-command" Click="ClearCapture_Click" Margin="0,0,8,8" />
                            <Button Content="{local:Loc Key=Controls.Cancel}" Tag="capture-command" Click="CancelCapture_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
