                        <Border BorderBrush="#885443" BorderThickness="1" Padding="2" Margin="0,0,14,0">
                            <Image Source="Assets/bloodborne-icon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="TECHMO" FontFamily="Georgia" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text=" Bloodborne" FontFamily="Georgia" FontSize="13" Foreground="#B8A995" VerticalAlignment="Center" Margin="3,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
