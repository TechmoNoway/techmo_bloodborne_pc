                                        <TextBlock Text="{local:Loc Key=Ui.Display}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavGraphics" Style="{StaticResource NavButton}" CommandParameter="Graphics" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Graphics}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Graphics}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavController" Style="{StaticResource NavButton}" CommandParameter="Controller" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Controls}">
