                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Saves.Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavOnline" Style="{StaticResource NavButton}" CommandParameter="Online" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Ui.Online}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Ui.Online}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavAdvanced" Style="{StaticResource NavButton}" CommandParameter="Advanced" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Hub.Diagnostics}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{local:Loc Key=Hub.Diagnostics}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Button x:Name="NavGeneral" Style="{StaticResource NavButton}" CommandParameter="General" Click="Nav_Click" AutomationProperties.Name="{local:Loc Key=Hub.Settings}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{local:Loc Key=Hub.Settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
