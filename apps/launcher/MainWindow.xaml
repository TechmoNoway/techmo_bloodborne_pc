                            <Button x:Name="ProfileMenuButton" Content="" FontFamily="Segoe MDL2 Assets" Padding="10,8" Margin="4,0,0,0" Click="ProfileMenu_Click" ToolTip="{local:Loc Key=Hub.Profile_actions}" AutomationProperties.Name="{local:Loc Key=Hub.Profile_actions}">
