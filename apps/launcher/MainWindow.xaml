                                    <TextBlock Text="Windows · x64" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="Workspace" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
