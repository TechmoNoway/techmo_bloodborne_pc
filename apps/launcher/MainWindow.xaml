                    <ScrollViewer Grid.Row="1" x:Name="GeneralPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,8,28,28" MaxWidth="1050" HorizontalAlignment="Stretch">
                            <TextBlock Text="{local:Loc Key=Ui.General}" FontFamily="Georgia" FontSize="32" />
                            <TextBlock Text="{local:Loc Key=Ui.Game_installation_and_language}" Foreground="#B0A89C" Margin="0,4,0,24" />
